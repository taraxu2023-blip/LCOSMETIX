# Local previews are always kept out of search by default.
# Configure the real deployed HTTPS origin only when this site is ready to replace it.
# SITE_URL=https://your-confirmed-domain.com
ENABLE_INDEXING=false

# Use an absolute path on a persistent, writable disk for Node.js production hosting.
# Defaults locally to .local-data/inquiries inside this project.
# Vercel: connect a PRIVATE Blob store in Storage. Keep its token server-only.
# BLOB_READ_WRITE_TOKEN=
# Vercel refuses inquiries with HTTP 503 until persistent storage is configured.
# Self-hosted Node.js only: a private persistent directory outside public/.
# INQUIRY_STORAGE_DIR=/var/lib/lcosmetix/inquiries
